generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Household {
  id        String @id @default(cuid())
  name      String @default("Notre famille")
  adults    Int @default(2)
  children  Child[]
  settings  Settings?
  plans     WeeklyPlan[]
  favorites Favorite[]
  exclusions ExcludedIngredient[]
  history MealHistory[]
}
model Child {
  id String @id @default(cuid())
  age Int
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
model Settings {
  householdId String @id
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  maxPrep Int @default(30)
  allergies String[]
}
model ExcludedIngredient {
  id String @id @default(cuid())
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name String
  kind String
  @@unique([householdId, name, kind])
}
model Recipe {
  id String @id
  source String @default("catalog")
  authorUid String?
  name String
  description String
  image String
  preparationTime Int
  cookingTime Int
  totalTime Int
  difficulty String
  instructions String[]
  categories String[]
  seasons String[]
  months Int[]
  allergens String[]
  childFriendly Boolean
  vegetarian Boolean
  servings Int
  protein String
  starch String
  style String
  light Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ingredients RecipeIngredient[]
  meals MealSlot[]
  favorites Favorite[]
  history MealHistory[]
}

model DriveState {
  id String @id @default("family")
  mode String
  store Json?
  cart Json @default("[]")
  updatedAt DateTime @updatedAt
}
model DriveSyncJob {
  id String @id @default(cuid())
  mode String
  storeId String
  week String
  planVersion Int
  status String
  proposals Json
  total Int @default(0)
  processed Int @default(0)
  success Int @default(0)
  failures String[]
  updatedAt DateTime @updatedAt
}
model IngredientProductPreference {
  id String @id @default(cuid())
  ingredient String
  storeId String
  productId String
  selectionCount Int @default(1)
  updatedAt DateTime @updatedAt
  @@unique([ingredient, storeId, productId])
}
model Ingredient {
  id String @id
  name String
  unit String
  category String
  recipes RecipeIngredient[]
}
model RecipeIngredient {
  recipeId String
  ingredientId String
  quantity Float
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
}
model WeeklyPlan {
  id String @id @default(cuid())
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  week String
  version Int @default(0)
  meals MealSlot[]
  shoppingList ShoppingList?
  @@unique([householdId, week])
}
model MealSlot {
  id String @id @default(cuid())
  planId String
  plan WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date String
  period String
  recipeId String?
  recipe Recipe? @relation(fields: [recipeId], references: [id])
  locked Boolean @default(false)
  history MealHistory?
  @@unique([planId, date, period])
}
model Favorite {
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@id([householdId, recipeId])
}
model MealHistory {
  id String @id @default(cuid())
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealId String @unique
  meal MealSlot @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id])
  date String
  @@index([householdId, date])
}
model ShoppingList {
  id String @id @default(cuid())
  planId String @unique
  plan WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]
}
model ShoppingListItem {
  id String @id @default(cuid())
  listId String
  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name String
  unit String
  category String
  quantity Float
  checked Boolean @default(false)
  manual Boolean @default(false)
  @@unique([listId, name, unit, manual])
}
