DATABASE_URL="postgresql://cuisine:cuisine@127.0.0.1:55432/cuisine?schema=public"
PORT=3001
NODE_ENV=development
# Connexion Google via Firebase. Obligatoires en production, sans clé privée.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Comptes Google vérifiés autorisés pour le foyer (séparés par une virgule).
FIREBASE_ALLOWED_EMAILS=
LECLERC_INTEGRATION_ENABLED=true
DRIVE_PROVIDER_MODE=mock
# Mode live : worker isolé avec navigateur et session Leclerc déjà connectée.
LECLERC_CONNECTOR_URL=
LECLERC_CONNECTOR_TOKEN=
LECLERC_REQUEST_DELAY_MS=1200
LECLERC_REQUEST_TIMEOUT_MS=15000
